<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 corre sobre .NET 10. Para 2025/2026 seria net8.0-windows y el paquete 2025.* / 2026.*. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>BeamRebar</AssemblyName>
    <RootNamespace>BeamRebar</RootNamespace>
    <!-- Revit ya carga sus propias DLL: no copiarlas al output -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- El submodulo esta dentro del proyecto: sus .cs los anade Arba.Comun.props (solo src/**), no el glob del SDK
         (que ademas arrastraria tests/ y build/ del comun y duplicaria cada archivo: CS2002). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);external/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Codigo comun ARBA (submodulo external/ARBA-comun, etiqueta v1.0.0): se compila como fuente dentro de
       este ensamblado (clases internal en el namespace Arba.Comun). EnableWindowsTargeting permite compilar
       fuera de Windows (CI); la copia a Revit solo se hace en Windows. -->
  <PropertyGroup>
    <RevitVersion>2027</RevitVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <Import Project="external/ARBA-comun/Arba.Comun.props" />

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copia automatica al directorio de add-ins de Revit al compilar en Debug -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(Configuration)'=='Debug' AND '$(OS)'=='Windows_NT'">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\2027\BeamRebar\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Exec Command="powershell -NoProfile -Command &quot;Remove-Item -Path '$(AddinDir)*.old' -Force -ErrorAction SilentlyContinue; if (Test-Path '$(AddinDir)$(TargetFileName)') { try { Copy-Item '$(TargetPath)' '$(AddinDir)' -Force -ErrorAction Stop } catch { $bak = '$(AddinDir)$(TargetFileName).' + [guid]::NewGuid().ToString('N') + '.old'; Move-Item '$(AddinDir)$(TargetFileName)' $bak -Force; Copy-Item '$(TargetPath)' '$(AddinDir)' -Force } } else { Copy-Item '$(TargetPath)' '$(AddinDir)' -Force }&quot;" />
    <Copy SourceFiles="$(ProjectDir)config.json" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(AddinDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" ContinueOnError="true" />
    <Copy SourceFiles="$(ProjectDir)BeamRebar.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2027\" />
  </Target>

</Project>
