<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>ARBA Vigas</Name>
    <Assembly>BeamRebar\BeamRebar.dll</Assembly>
    <FullClassName>BeamRebar.RibbonApp</FullClassName>
    <ClientId>c3f1a9d2-6b47-4e0a-9d21-58f0b7c2e614</ClientId>
    <VendorId>LOCAL</VendorId>
    <VendorDescription>Uso interno</VendorDescription>
  </AddIn>
  <AddIn Type="Command">
    <Name>Armar viga</Name>
    <Text>Armar viga</Text>
    <Description>Genera el armado de vigas de seccion rectangular, en T o en L, de seccion constante o variable a lo largo de su longitud (barras longitudinales por capas con varios diametros, bastones arriba o abajo y estribos rectangulares) a partir de la geometria del elemento, con una ventana para elegir el armado y los aceros.</Description>
    <Assembly>BeamRebar\BeamRebar.dll</Assembly>
    <FullClassName>BeamRebar.ArmarVigaCommand</FullClassName>
    <ClientId>e8a4d0b7-2c15-4f39-b6e2-7a91d3c5f048</ClientId>
    <VendorId>LOCAL</VendorId>
    <VendorDescription>Uso interno</VendorDescription>
    <VisibilityMode>NotVisibleInFamily</VisibilityMode>
  </AddIn>
</RevitAddIns>
